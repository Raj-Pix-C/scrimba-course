{
    "manifest_version": 3,
    "name": "Leads Tracker",
    "version": "1.0",
    "description": "A simple chrome extension to track leads",
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "permissions": [
        "storage",
        "tabs"
    ]
}